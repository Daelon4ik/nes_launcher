{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dlemu",
  "version": "0.9.1",
  "identifier": "com.nes-launhder.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {}
  },
  "app": {
    "windows": [
      {
        "title": "dlemu",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/*", "$APPDATA/store_previews/*"]
      }
    }
  }
}
